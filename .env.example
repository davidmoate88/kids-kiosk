# Copy the values you need into .env.local (already gitignored).

# Existing — YouTube Data API key for the watch/tv catalogue and the new
# ingestion sync.
YOUTUBE_API_KEY=

# Local dev: a local Postgres matching these defaults (see docker-compose.yml,
# or a native install — `createuser kids_kiosk` / `createdb -O kids_kiosk
# kids_kiosk` with the same password). Production points at Postgres running
# on the same self-hosted LXC as the app (see docs/DEPLOY_HOME_SERVER.md).
DATABASE_URL=postgresql://kids_kiosk:dev_only_password@localhost:5432/kids_kiosk

# Auth.js session signing secret. Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# Shared secret the nightly cron route checks against — whatever triggers
# it (a crontab/systemd timer hitting the route over HTTP) has no identity
# of its own to check. Generate the same way as AUTH_SECRET.
CRON_SECRET=

# Used once by `npm run db:seed` to create the /parents PIN (4-8 digits).
# Gates the dashboard from the kids on the home network, not from the
# internet — a shared PIN, not a per-parent account. Not read at runtime
# afterwards; change the PIN from the dashboard's Account tab instead.
SEED_PARENT_PIN=

# Base URL of David's own stremio-platform-catalogs addon (a separate repo/
# deployment — see its own README). Catalog browsing/search only — never
# used for stream resolution.
STREMIO_CATALOG_URL=

# AIOStreams' install/transport URL (found via Stremio's own installed-
# addons list — see the Phase 3 plan). Stream resolution ONLY for a specific
# already-approved imdbId — this instance has content categories (including
# adult ones) that must never drive discovery/browsing, so nothing in this
# codebase should ever call it for anything else.
AIOSTREAMS_URL=
